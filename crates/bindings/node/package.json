{
  "name": "@grafeo-db/js",
  "version": "0.0.1",
  "description": "Node.js/TypeScript bindings for Grafeo - a high-performance embeddable graph database",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "grafeo",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl"
    ],
    "dtsHeaderFile": "types-header.d.ts"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@grafeo-db/js-darwin-x64": "0.0.1",
    "@grafeo-db/js-win32-x64-msvc": "0.0.1",
    "@grafeo-db/js-linux-x64-gnu": "0.0.1",
    "@grafeo-db/js-darwin-arm64": "0.0.1",
    "@grafeo-db/js-linux-arm64-gnu": "0.0.1",
    "@grafeo-db/js-linux-arm64-musl": "0.0.1"
  },
  "keywords": [
    "graph",
    "database",
    "gql",
    "cypher",
    "sparql",
    "knowledge-graph",
    "native",
    "napi",
    "embedded"
  ],
  "author": "S.T. Grond",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrafeoDB/grafeo.git",
    "directory": "crates/bindings/node"
  },
  "homepage": "https://grafeo.dev",
  "bugs": {
    "url": "https://github.com/GrafeoDB/grafeo/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "artifacts": "npx --prefix tools --no-install napi artifacts",
    "build": "npx --prefix tools --no-install napi build --platform --release --features full -- --locked && node -e \"require('fs').appendFileSync('index.js', require('fs').readFileSync('loader-footer.js'))\"",
    "build:debug": "npx --prefix tools --no-install napi build --platform -- --locked && node -e \"require('fs').appendFileSync('index.js', require('fs').readFileSync('loader-footer.js'))\"",
    "test": "npx --prefix tools --no-install vitest run",
    "version": "npx --prefix tools --no-install napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.5",
    "@types/node": "20.19.43",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
